[2.291185, "o", "\r\n"]
[2.44115, "o", "react-native-agent-bridge demo: an agent drives a React Native screen by its components\r\n"]
[2.441477, "o", "A fixture Project settings screen, no device and no model: a script plays the agent.\r\n\r\n"]
[6.044472, "o", "agent> snapshot()\r\n"]
[6.044722, "o", "  c1  text-field Project name             value=\"Apollo\"     setValue\r\n  c2  picker     Visibility               value=\"Private\"    setValue\r\n  c3  switch     Email / Deploy failures  checked=false      setChecked\r\n  c4  switch     Email / Weekly digest    checked=true       setChecked\r\n  c5  text-field API token                value=\"[redacted]\" setValue\r\n  c6  button     Jane Doe / Remove                           [needs a person] press\r\n  c7  button     Tom Becker / Remove                         [needs a person] press\r\n  c9  button     Save                                        press\r\n  (8 components listed. The \"Delete project\" button is hidden from agents.)\r\n"]
[9.64788, "o", "\u001b[2J\u001b[Hagent> act: one call, three steps, by the words in the task\r\n"]
[9.651652, "o", "  Project name: \"Atlas\"\r\n  Visibility: \"Internal\"\r\n  Deploy failures: true\r\n"]
[13.255997, "o", "\r\nagent> act: remove Tom Becker   (the app marked this confirm)\r\n"]
[13.256121, "o", "  refused: Needs a person: Removes Tom Becker from the project. Cannot be undone from\r\n  the app. Tell them what it does and let them do it.\r\n"]
[16.859629, "o", "\r\nagent> same step, with an allow callback that asks the person on the device\r\n"]
[16.859971, "o", "  phone> \"Removes Tom Becker from the project. Cannot be undone from the app.\"\r\n  [Allow] [Deny]   -> person taps Allow\r\n"]
[16.862502, "o", "  ran: press c7, press c17   members now: Jane Doe   saved: 1\r\n"]
[20.463088, "o", "\u001b[2J\u001b[Hagent> query({ text: \"Jane\" })\r\n"]
[20.464276, "o", "  c15 button     Jane Doe / Remove                           [needs a person] press\r\n\r\nagent> act on a name that is not there: \"Remove all\"\r\n"]
[20.464495, "o", "  Nothing is named \"Remove all\". On screen: c10 text-field \"Project name\"; c11 picker\r\n  \"Visibility\"; c12 switch \"Deploy fai...\r\n\r\nPut it in your app: useAgentComponent({ component, label, state, actions }) in each\r\ncomponent (react-native-agent-bridge/react).\r\nMeasured with a real model on an Android emulator: see the table in the README.\r\n"]
[20.468934, "o", "⠙"]
[20.469619, "o", "\u001b[1G\u001b[0K"]
