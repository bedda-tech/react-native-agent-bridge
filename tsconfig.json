{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "rootDir": "."
  },
  "include": [
    "src",
    "test",
    "examples",
    "bench"
  ],
  "exclude": [
    "examples/expo",
    "examples/expo-app",
    "bench/model"
  ]
}
