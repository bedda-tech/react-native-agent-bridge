{
  "name": "react-native-agent-bridge",
  "version": "0.1.0",
  "description": "Let an AI agent read and drive a React Native app through the components themselves: snapshot, query, act, allow. The UI SDK agent bridge, for native apps.",
  "license": "MIT",
  "author": "BeddaTech, LLC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./device-agent": {
      "types": "./dist/device-agent.d.ts",
      "default": "./dist/device-agent.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/run.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.3.1",
    "react": "^19.0.0",
    "react-test-renderer": "^19.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "react-native",
    "expo",
    "agents",
    "mcp",
    "webmcp",
    "ai",
    "testing",
    "accessibility"
  ],
  "bin": {
    "react-native-agent-bridge": "./dist/bin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedda-tech/react-native-agent-bridge.git"
  },
  "homepage": "https://github.com/bedda-tech/react-native-agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/bedda-tech/react-native-agent-bridge/issues"
  }
}
